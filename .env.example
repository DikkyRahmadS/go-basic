# App Configuration
APP_PORT=8080
APP_ENV=development

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_internal

# Database Pool Settings
DB_IDLE_CONNECTIONS=10
